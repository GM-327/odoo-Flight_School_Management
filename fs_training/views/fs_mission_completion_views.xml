<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mission Completion List View -->
    <record id="view_fs_mission_completion_list" model="ir.ui.view">
        <field name="name">fs.mission.completion.list</field>
        <field name="model">fs.mission.completion</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-success="is_completed" decoration-muted="not is_completed">
                <field name="student_id" readonly="1"/>
                <field name="training_class_id" readonly="1" optional="hide"/>
                <field name="mission_id"/>
                <field name="mission_name" readonly="1"/>
                <field name="is_completed" widget="boolean_toggle"/>
                <field name="completion_date"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Mission Completion Form View -->
    <record id="view_fs_mission_completion_form" model="ir.ui.view">
        <field name="name">fs.mission.completion.form</field>
        <field name="model">fs.mission.completion</field>
        <field name="arch" type="xml">
            <form string="Mission Completion">
                <sheet>
                    <group>
                        <group string="Enrollment">
                            <field name="enrollment_id"/>
                            <field name="student_id" readonly="1"/>
                            <field name="training_class_id" readonly="1"/>
                        </group>
                        <group string="Mission">
                            <field name="mission_id"/>
                            <field name="mission_name" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Completion Status">
                            <field name="is_completed" widget="boolean_toggle"/>
                            <field name="completion_date" invisible="not is_completed"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Additional notes about this mission completion..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Mission Completion Search View -->
    <record id="view_fs_mission_completion_search" model="ir.ui.view">
        <field name="name">fs.mission.completion.search</field>
        <field name="model">fs.mission.completion</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_completed" string="Completed" domain="[('is_completed', '=', True)]"/>
                <filter name="filter_pending" string="Pending" domain="[('is_completed', '=', False)]"/>
                <separator/>
                <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                <filter name="group_class" string="Training Class" context="{'group_by': 'training_class_id'}"/>
                <filter name="group_mission" string="Mission" context="{'group_by': 'mission_id'}"/>
            </search>
        </field>
    </record>

    <!-- Mission Completion Action -->
    <record id="action_fs_mission_completion" model="ir.actions.act_window">
        <field name="name">Mission Completions</field>
        <field name="res_model">fs.mission.completion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No mission completions yet
            </p>
            <p>
                Track mission completion status for student enrollments.
            </p>
        </field>
    </record>
</odoo>
