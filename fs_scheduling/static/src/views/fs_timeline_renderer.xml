<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Inherit timeline renderer to add zoom buttons -->
    <t t-name="fs_scheduling.TimelineRendererInherit" t-inherit="web_timeline.TimelineRenderer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('btn-group')]" position="after">
            <div class="btn-group btn-sm ms-2">
                <button class="btn btn-default fa fa-search-minus" t-on-click="_onZoomOut" title="Zoom Out"/>
                <button class="btn btn-default fa fa-search-plus" t-on-click="_onZoomIn" title="Zoom In"/>
            </div>
        </xpath>
    </t>
</templates>
