<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Scheduling Wizard Form View -->
    <record id="view_fs_scheduling_wizard_form" model="ir.ui.view">
        <field name="name">fs.scheduling.wizard.form</field>
        <field name="model">fs.scheduling.wizard</field>
        <field name="arch" type="xml">
            <form string="Mission Scheduling Wizard">
                <field name="state" invisible="1"/>
                <header>
                    <!-- Reset Button (visible on all steps except step1) -->
                    <button name="action_reset" string="⟳ Reset" type="object" 
                            class="btn-outline-danger" icon="fa-undo"
                            invisible="state == 'step1'"
                            confirm="This will clear all generated lines and return to Step 1. Continue?"/>
                    
                    <!-- Step 1 buttons -->
                    <button name="action_next_step" string="Generate Schedule →" type="object" 
                            class="btn-primary" icon="fa-arrow-right"
                            invisible="state != 'step1'"/>
                    
                    <!-- Step 2 buttons -->
                    <button name="action_previous_step" string="← Back" type="object" 
                            class="btn-secondary" icon="fa-arrow-left"
                            invisible="state != 'step2'"/>
                    <button name="action_next_step" string="Assign Schedule →" type="object" 
                            class="btn-primary" icon="fa-clock-o"
                            invisible="state != 'step2'"/>
                    
                    <!-- Step 3 buttons -->
                    <button name="action_previous_step" string="← Back to Edit" type="object" 
                            class="btn-secondary" icon="fa-arrow-left"
                            invisible="state != 'step3'"/>
                    <button name="action_schedule" string="Create Flights ✓" type="object" 
                            class="btn-success" icon="fa-check"
                            invisible="state != 'step3'"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="step1,step2,step3"/>
                </header>
                <sheet>
                    <!-- Step 1: Selection - Modern & UX Friendly -->
                    <div invisible="state != 'step1'" class="o_fs_scheduling_wizard_step">
                        <!-- Hero Section with Gradient -->
                        <div class="card border-0 rounded-3 shadow-sm mb-4" 
                             style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); overflow: hidden; position: relative; color: white;">
                            <div class="card-body p-4 position-relative" style="z-index: 1;">
                                <div class="row align-items-center">
                                    <div class="col-auto d-none d-md-block">
                                        <div class="bg-white bg-opacity-25 rounded-circle p-4 shadow-sm" style="backdrop-filter: blur(8px);">
                                            <i class="fa fa-rocket fa-3x text-white" title="Rocket Icon"/>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <h1 class="display-6 fw-bold mb-1 text-white">Step 1: Resource Planning</h1>
                                        <p class="lead mb-0 opacity-75">Configure the flight window and build your mission team.</p>
                                    </div>
                                </div>
                            </div>
                            <!-- Decorative background element -->
                            <div style="position: absolute; top: -50px; right: -50px; width: 250px; height: 250px; background: rgba(255,255,255,0.05); border-radius: 50%; pointer-events: none;"/>
                        </div>
                        
                        <div class="row g-4 mb-4">
                            <!-- Left: Basic Parameters Card -->
                            <div class="col-lg-5">
                                <div class="card border-0 shadow-sm h-100 rounded-3">
                                    <div class="card-body p-4">
                                        <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px;">
                                                <i class="fa fa-calendar-check-o" title="Calendar Icon"/>
                                            </div>
                                            <h4 class="mb-0 fw-bold">Date &amp; Time Window</h4>
                                        </div>
                                        
                                        <div class="p-4 bg-light rounded-3 mb-4 text-center">
                                            <label for="date" class="form-label text-muted small d-block mb-1">SELECTED DATE</label>
                                            <field name="date" class="fs-3 fw-bolder text-primary"/>
                                        </div>

                                        <group>
                                            <label for="first_start_time" string="Time Window"/>
                                            <div class="o_row">
                                                <field name="first_start_time" widget="float_time" class="oe_inline" no_label="1"/>
                                                <i class="fa fa-long-arrow-right mx-2 text-muted" title="to"/>
                                                <field name="last_end_time" widget="float_time" class="oe_inline" no_label="1"/>
                                            </div>
                                            <field name="next_callsign_number" string="Starting ID #" help="The starting number for callsigns generated in this batch."/>
                                            <field name="callsign_prefix" invisible="1"/>
                                        </group>

                                        <div role="status" style="background: rgba(255,193,7,0.1); display: flex; align-items: center; border-radius: 0.5rem; padding: 1rem; margin-top: 1.5rem;">
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-lightbulb-o fa-2x me-3 text-warning opacity-75" title="Lightbulb Icon"/>
                                                <div class="small">
                                                    <strong>Optimization Active:</strong> The scheduler will balance the load across the specified window.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Resource Selection Card -->
                            <div class="col-lg-7">
                                <div class="card border-0 shadow-sm h-100 rounded-3">
                                    <div class="card-body p-4">
                                        <!-- Students Selection -->
                                        <div class="mb-5">
                                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px;">
                                                        <i class="fa fa-graduation-cap" title="Students Icon"/>
                                                    </div>
                                                    <h4 class="mb-0 fw-bold">Available Students</h4>
                                                </div>
                                                <span class="badge rounded-pill bg-info bg-opacity-10 text-info px-3 fw-normal">Active Enrollments Only</span>
                                            </div>
                                            
                                            <div class="p-3 border border-dashed rounded-3 bg-light" style="border: 2px dashed #e9ecef;">
                                                <field name="selected_enrollment_ids" widget="many2many_tags" 
                                                       options="{'no_create': True, 'no_quick_create': True}"
                                                       placeholder="Add students to schedule..."
                                                       context="{'search_default_group_by_class': 1}"
                                                       class="w-100 fs-5"/>
                                            </div>
                                            <div class="text-muted small mt-2 d-flex align-items-center">
                                                <i class="fa fa-info-circle me-1" title="Information Icon"/> Students are grouped by training class for easier selection.
                                            </div>
                                        </div>

                                        <!-- Instructors Selection -->
                                        <div>
                                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px;">
                                                        <i class="fa fa-id-card-o" title="Instructors Icon"/>
                                                    </div>
                                                    <h4 class="mb-0 fw-bold">Available Instructors</h4>
                                                </div>
                                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 fw-normal">Duty Selection</span>
                                            </div>
                                            
                                            <div class="p-3 border border-dashed rounded-3 bg-light" style="border: 2px dashed #e9ecef;">
                                                <field name="selected_instructor_ids" widget="many2many_tags"
                                                       options="{'no_create': True, 'no_quick_create': True}"
                                                       placeholder="Search for available staff..."
                                                       context="{'search_default_group_by_eligibility': 1}"
                                                       class="w-100 fs-5"/>
                                            </div>
                                            <div class="text-muted small mt-2 d-flex align-items-center">
                                                <i class="fa fa-check-circle-o me-1 text-success" title="Validation Icon"/> Only instructors with valid medical and English qualifications will be assigned.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Review, Adjust & Reorder -->
                    <div invisible="state != 'step2'">
                        <!-- Modern Header -->
                        <div class="card border-0 rounded-3 shadow-sm mb-4" 
                             style="background: linear-gradient(135deg, #374151 0%, #111827 100%); overflow: hidden; position: relative; color: white;">
                            <div class="card-body p-4 position-relative" style="z-index: 1;">
                                <div class="row align-items-center">
                                    <div class="col-auto d-none d-md-block">
                                        <div class="bg-white bg-opacity-25 rounded-circle p-4 shadow-sm" style="backdrop-filter: blur(8px);">
                                            <i class="fa fa-tasks fa-3x text-white" title="Tasks Icon"/>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <h1 class="display-6 fw-bold mb-1 text-white">Step 2: Review &amp; Sequence</h1>
                                        <p class="lead mb-0 opacity-75">
                                            Configure mission types and crew. Use arrows to optimize the sequence.
                                            <span class="badge bg-white bg-opacity-25 ms-2 px-3 fw-normal">
                                                <field name="selected_count" nolabel="1" class="oe_inline"/> Missions Pending
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons Row -->
                        <div class="d-flex justify-content-between mb-3">
                            <!-- Bulk Actions (Left) -->
                            <div class="btn-group">
                                <button name="action_bulk_assign_route" type="object" 
                                        class="btn btn-outline-secondary" icon="fa-map-marker"
                                        title="Assign route to all lines without route">
                                    <span>Bulk Route</span>
                                </button>
                                <button name="action_bulk_mark_add" type="object" 
                                        class="btn btn-outline-warning" icon="fa-plus-circle"
                                        title="Mark lines as ADD missions">
                                    <span>Bulk ADD</span>
                                </button>
                            </div>
                            
                            <!-- Add Mission Button (Right) -->
                            <button name="action_add_mission" type="object" 
                                    class="btn btn-primary" icon="fa-plus">
                                <span>Add Mission</span>
                            </button>
                        </div>

                        <!-- Student Double Booking Warning Banner -->
                        <field name="has_student_double_booking" invisible="1"/>
                        <div role="alert" invisible="not has_student_double_booking" 
                             class="alert alert-info d-flex align-items-start mb-3" style="border-left: 4px solid #0dcaf0;">
                            <i class="fa fa-info-circle fa-2x me-3 text-info" title="Info"/>
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-1">ℹ️ Student Scheduled Multiple Times</h6>
                                <p class="mb-1 small">The following students have more than one flight scheduled. This may be intentional for multi-mission days:</p>
                                <field name="student_double_booking_details" nolabel="1" class="small text-muted" widget="text"/>
                            </div>
                        </div>

                        <!-- Examinator Warning Banner (Non-blocking) -->
                        <field name="has_pending_examinator_warning" invisible="1"/>
                        <div role="alert" invisible="not has_pending_examinator_warning" 
                             class="alert alert-warning d-flex align-items-center mb-3" style="border-left: 4px solid #ffc107;">
                            <i class="fa fa-exclamation-triangle fa-2x me-3 text-warning" title="Warning"/>
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-1">⚠️ Examinator Qualification Warning</h6>
                                <p class="mb-0 small">Some exam flights do not have an instructor with examinator qualification. You can proceed, but you will be asked to confirm.</p>
                            </div>
                        </div>

                        <field name="line_ids" nolabel="1">
                            <list create="0" decoration-info="is_sim">
                                <field name="is_sim" column_invisible="1"/>
                                <field name="flight_category" column_invisible="1"/>
                                <field name="sequence" string="#" readonly="1" width="30px"/>
                                <field name="is_added_mission" widget="boolean_toggle" string="Added"/>
                                <button name="action_move_first" type="object" icon="fa-angle-double-up" title="Move to First"/>
                                <button name="action_move_up" type="object" icon="fa-arrow-up" title="Move Up"/>
                                <button name="action_move_down" type="object" icon="fa-arrow-down" title="Move Down"/>
                                <button name="action_move_last" type="object" icon="fa-angle-double-down" title="Move to Last"/>
                                <!-- Pilot 1 (Editable) -->
                                <field name="pilot1_function" string="P1 Func" optional="hide"/>
                                <field name="pilot1_crew_id" string="Pilot 1" 
                                       options="{'no_create': True}"
                                       domain="[('has_expired_qualification', '=', False)]"/>
                                <!-- Pilot 2 (Editable) -->
                                <field name="pilot2_function" string="P2 Func" optional="hide"/>
                                <field name="pilot2_crew_id" string="Pilot 2" 
                                       options="{'no_create': True}"
                                       domain="[('member_type', 'in', ['instructor', 'pilot']), ('has_expired_qualification', '=', False)]"/>
                                <field name="training_class_code" readonly="1" string="Class" optional="hide"/>
                                <field name="class_type_id" column_invisible="1"/>
                                <field name="aircraft_type_ids" string="A/C Types" widget="many2many_tags" optional="hide"/>
                                <!-- Mission for Student Training -->
                                <!-- Single Readonly Activity Column -->
                                <field name="mission_id" string="Mission" readonly="1"
                                       invisible="flight_category != 'student_training'"/>
                                <field name="activity_display" string="Activity" readonly="1"/>
                                
                                <!-- Hidden Fields (editable in Form View) -->
                                <field name="mission_id" column_invisible="1"/>
                                <field name="activity_id" column_invisible="1"/>
                                <field name="custom_activity_id" column_invisible="1"/>
                                <field name="has_examinator_warning" column_invisible="1"/>
                                <button icon="fa-graduation-cap" class="btn-link text-success fa-lg" title="EXAM - Examinator Assigned ✓" 
                                        invisible="not is_exam or has_examinator_warning" disabled="1"/>
                                <button icon="fa-exclamation-triangle" class="btn-link text-warning fa-lg" 
                                        title="⚠️ EXAM - Missing Examinator Qualification!" 
                                        invisible="not has_examinator_warning" disabled="1"/>
                                <field name="route_id" string="Route / Area" options="{'no_create': True, 'no_open': True, 'order': 'sequence, name'}"/>
                                <field name="duration" widget="float_time"/>
                                <field name="flight_type_id" string="Type" column_invisible="1"/>
                                <field name="is_exam" column_invisible="1"/>
                            </list>
                        </field>
                    </div>

                    <!-- Step 3: Confirmation -->
                    <div invisible="state != 'step3'">
                        <!-- Modern Header -->
                        <div class="card border-0 rounded-3 shadow-sm mb-4" 
                             style="background: linear-gradient(135deg, #047857 0%, #10b981 100%); overflow: hidden; position: relative; color: white;">
                            <div class="card-body p-4 position-relative" style="z-index: 1;">
                                <div class="row align-items-center">
                                    <div class="col-auto d-none d-md-block">
                                        <div class="bg-white bg-opacity-25 rounded-circle p-4 shadow-sm" style="backdrop-filter: blur(8px);">
                                            <i class="fa fa-check-circle fa-3x text-white" title="Check Icon"/>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <h1 class="display-6 fw-bold mb-1 text-white">Step 3: Final Confirmation</h1>
                                        <p class="lead mb-0 opacity-75">Review the generated schedule. Ensure callsigns and aircraft assignments are correct.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Summary Statistics Card -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <div class="card border-0 rounded-3 h-100" style="background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);">
                                    <div class="card-body text-center py-3">
                                        <div class="text-white fs-2 fw-bold">
                                            <field name="selected_count" nolabel="1" class="oe_inline"/>
                                        </div>
                                        <div class="text-white opacity-75 small">Total Flights</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card border-0 rounded-3 h-100" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
                                    <div class="card-body text-center py-3">
                                        <div class="text-white fs-2 fw-bold">
                                            <field name="total_flight_hours" nolabel="1" widget="float_time" class="oe_inline"/>
                                        </div>
                                        <div class="text-white opacity-75 small">Total Hours</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card border-0 rounded-3 h-100" style="background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);">
                                    <div class="card-body text-center py-3">
                                        <div class="text-white fs-2 fw-bold">
                                            <field name="utilized_instructors_count" nolabel="1" class="oe_inline"/>
                                        </div>
                                        <div class="text-white opacity-75 small">Instructors</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card border-0 rounded-3 h-100" style="background: linear-gradient(135deg, #6b7280 0%, #9ca3af 100%);">
                                    <div class="card-body text-center py-3">
                                        <div class="text-white fs-2 fw-bold">
                                            <field name="utilized_aircraft_count" nolabel="1" class="oe_inline"/>
                                        </div>
                                        <div class="text-white opacity-75 small">Aircraft Used</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Aircraft Assignment Warning -->
                        <field name="unassigned_aircraft_count" invisible="1"/>
                        <div role="alert" invisible="unassigned_aircraft_count == 0" 
                             class="alert alert-danger d-flex align-items-center mb-3" style="border-left: 4px solid #dc3545;">
                            <i class="fa fa-plane fa-2x me-3 text-danger" title="Warning"/>
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-1">⚠️ Aircraft Assignment Issue</h6>
                                <p class="mb-0 small">
                                    <field name="unassigned_aircraft_count" nolabel="1" class="oe_inline"/> 
                                    flight(s) could not be assigned an aircraft. Please manually assign aircraft or adjust the time window.
                                </p>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded-3 border">
                            <div class="d-flex align-items-center flex-grow-1">
                                <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                    <i class="fa fa-info-circle fa-lg" title="Summary Icon"/>
                                </div>
                                <div>
                                    <h5 class="mb-0 fw-bold">
                                        Ready to create <field name="selected_count" nolabel="1" class="oe_inline"/> missions 
                                        for <field name="date" nolabel="1" class="oe_inline"/>.
                                    </h5>
                                    <p class="text-muted small mb-0">
                                        <i class="fa fa-mouse-pointer me-1" title="Pointer"/> Adjust times and aircraft below before final confirmation.
                                    </p>
                                </div>
                            </div>
                            <button name="action_reschedule" type="object" 
                                    class="btn btn-outline-primary" icon="fa-refresh">
                                <span>Reschedule Unlocked</span>
                            </button>
                        </div>

                        <field name="line_ids">
                            <list editable="bottom" create="0" decoration-info="is_sim" decoration-danger="aircraft_assignment_warning">
                                <field name="is_sim" column_invisible="1"/>
                                <field name="is_locked" column_invisible="1"/>
                                <field name="flight_category" column_invisible="1"/>
                                <field name="aircraft_assignment_warning" column_invisible="1"/>
                                <!-- Lock Toggle Button Group -->
                                <button name="toggle_lock" type="object" icon="fa-lock" 
                                        class="text-warning fa-lg" invisible="not is_locked" 
                                        title="Unlock this line" wrapper_class="text-center px-2"/>
                                <button name="toggle_lock" type="object" icon="fa-unlock-alt" 
                                        class="text-muted opacity-50 fa-lg" invisible="is_locked" 
                                        title="Lock this line" wrapper_class="text-center px-2"/>
                                
                                <!-- Aircraft assignment warning icon -->
                                <button icon="fa-exclamation-circle" class="btn-link text-danger fa-lg" 
                                        title="⚠️ No aircraft could be assigned - Please assign manually" 
                                        invisible="not aircraft_assignment_warning or aircraft_id" disabled="1"/>
                                
                                <field name="is_added_mission" widget="boolean_toggle" string="ADD"/>
                                <field name="callsign_display" string="Callsign"/>
                                <!-- Pilot 1 -->
                                <field name="pilot1_function" string="P1" readonly="1" optional="hide"/>
                                <field name="pilot1_crew_id" string="Pilot 1" readonly="1"/>
                                <!-- Pilot 2 -->
                                <field name="pilot2_function" string="P2" readonly="1" optional="hide"/>
                                <field name="pilot2_crew_id" string="Pilot 2" readonly="1"/>
                                <!-- Activity Display - Combined column -->
                                <field name="activity_display" string="Activity" readonly="1"/>
                                <field name="activity_id" column_invisible="1"/>
                                <field name="custom_activity_id" column_invisible="1"/>
                                <field name="mission_id" column_invisible="1"/>
                                <field name="route_id" string="Route" options="{'no_create': True, 'no_open': True, 'order': 'sequence, name'}"/>
                                <field name="allowed_aircraft_ids" column_invisible="1"/>
                                <field name="aircraft_id" options="{'no_create': True}"
                                       domain="[('id', 'in', allowed_aircraft_ids)]"/>
                                <field name="start_time" widget="float_time" string="ETD"/>
                                <field name="end_time" widget="float_time" string="ETA"/>
                                <field name="duration" widget="float_time" readonly="1"/>
                                <field name="flight_type_id" string="Type" column_invisible="1"/>
                                <field name="aircraft_type_ids" widget="many2many_tags" optional="hide"/>
                            </list>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Examinator Warning Confirmation Dialog -->
    <record id="view_fs_scheduling_wizard_examinator_warning_form" model="ir.ui.view">
        <field name="name">fs.scheduling.wizard.examinator.warning.form</field>
        <field name="model">fs.scheduling.wizard</field>
        <field name="arch" type="xml">
            <form string="Examinator Qualification Warning">
                <sheet>
                    <!-- Warning Header -->
                    <div class="card border-0 rounded-3 shadow-sm mb-4" 
                         style="background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%); overflow: hidden; position: relative; color: white;">
                        <div class="card-body p-4 position-relative" style="z-index: 1;">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <div class="bg-white bg-opacity-25 rounded-circle p-3 shadow-sm" style="backdrop-filter: blur(8px);">
                                        <i class="fa fa-exclamation-triangle fa-2x text-white" title="Warning"/>
                                    </div>
                                </div>
                                <div class="col">
                                    <h2 class="fw-bold mb-1">⚠️ Examinator Qualification Missing</h2>
                                    <p class="mb-0 opacity-90">The following exam flights do not have an instructor with examinator qualification.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Details -->
                    <div class="card border-warning rounded-3 mb-4">
                        <div class="card-header bg-warning bg-opacity-10 border-warning">
                            <h5 class="mb-0 text-warning">
                                <i class="fa fa-graduation-cap me-2" title="Exam"/>Affected Exam Flights
                            </h5>
                        </div>
                        <div class="card-body">
                            <field name="examinator_warning_details" readonly="1" nolabel="1" 
                                   class="fs-5 text-danger" widget="text"/>
                        </div>
                    </div>

                    <!-- Explanation -->
                    <div class="alert alert-info d-flex align-items-start" role="alert">
                        <i class="fa fa-info-circle fa-2x me-3 mt-1" title="Info"/>
                        <div>
                            <h6 class="fw-bold mb-1">What does this mean?</h6>
                            <p class="mb-2 small">
                                Exam flights require an instructor with a valid <strong>Examinator Qualification</strong> 
                                to conduct the examination. The assigned instructors do not currently have this qualification.
                            </p>
                            <p class="mb-0 small text-muted">
                                <strong>You can:</strong><br/>
                                • <strong>Go back</strong> to Step 2 and assign an instructor with examinator qualification<br/>
                                • <strong>Proceed anyway</strong> if the qualification will be verified later or is not strictly required
                            </p>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_cancel_examinator_warning" type="object" 
                            string="← Go Back and Fix" class="btn-secondary" icon="fa-arrow-left"/>
                    <button name="action_confirm_examinator_warning" type="object" 
                            string="Proceed Anyway →" class="btn-warning" icon="fa-exclamation-triangle"/>
                </footer>
            </form>
        </field>
    </record>

