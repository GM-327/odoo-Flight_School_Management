<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bulk Action Wizard Form View -->
    <record id="view_fs_scheduling_wizard_bulk_action_form" model="ir.ui.view">
        <field name="name">fs.scheduling.wizard.bulk.action.form</field>
        <field name="model">fs.scheduling.wizard.bulk.action</field>
        <field name="arch" type="xml">
            <form string="Bulk Action">
                <sheet>
                    <!-- Hero Section -->
                    <div class="card border-0 rounded-3 shadow-sm mb-4" 
                         style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); overflow: hidden; position: relative; color: white;">
                        <div class="card-body p-4 position-relative" style="z-index: 1;">
                            <div class="row align-items-center">
                                <div class="col-auto d-none d-md-block">
                                    <div class="bg-white bg-opacity-25 rounded-circle p-3 shadow-sm" style="backdrop-filter: blur(8px);">
                                        <i class="fa fa-magic fa-2x text-white" title="Bulk Action"/>
                                    </div>
                                </div>
                                <div class="col">
                                    <h2 class="fw-bold mb-1">
                                        <field name="display_name" nolabel="1" class="d-inline text-white"/>
                                    </h2>
                                    <p class="mb-0 opacity-75">
                                        Apply changes to <field name="line_count" nolabel="1" class="d-inline"/> lines
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <field name="wizard_id" invisible="1"/>
                    <field name="action_type" invisible="1"/>

                    <!-- Route Assignment Form -->
                    <div invisible="action_type != 'route'">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-3 border-bottom pb-2">
                                    <i class="fa fa-map-marker text-primary me-2" title="Route"/>Select Route
                                </h5>
                                <group>
                                    <field name="route_id" 
                                           options="{'no_create': True}"
                                           required="action_type == 'route'"
                                           string="Route / Area"/>
                                    <field name="apply_to_lines_without_route" widget="boolean_toggle"/>
                                </group>
                                <div role="alert" class="alert alert-info mt-3 mb-0 small">
                                    <i class="fa fa-info-circle me-2" title="Info"/>
                                    Lines with simulator missions will not be affected.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Aircraft Type Assignment Form -->
                    <div invisible="action_type != 'aircraft_type'">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-3 border-bottom pb-2">
                                    <i class="fa fa-plane text-primary me-2" title="Aircraft"/>Select Aircraft Type
                                </h5>
                                <group>
                                    <field name="aircraft_type_id" 
                                           options="{'no_create': True}"
                                           required="action_type == 'aircraft_type'"
                                           domain="[('is_simulator', '=', False)]"
                                           string="Aircraft Type"/>
                                    <field name="replace_existing" widget="boolean_toggle"
                                           help="If enabled, replaces existing types. Otherwise, adds to existing."/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <!-- ADD Mission Form -->
                    <div invisible="action_type != 'add_mission'">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-3 border-bottom pb-2">
                                    <i class="fa fa-plus-circle text-warning me-2" title="ADD"/>Mark as ADD Mission
                                </h5>
                                <div role="alert" class="alert alert-warning mb-0">
                                    <h6 class="fw-bold mb-2">
                                        <i class="fa fa-exclamation-triangle me-2" title="Warning"/>Confirmation
                                    </h6>
                                    <p class="mb-0">
                                        This will mark all <strong><field name="line_count" nolabel="1" class="d-inline"/></strong> 
                                        eligible lines as <strong>ADD</strong> missions. 
                                        ADD missions will have "ADD" as their callsign instead of a numbered sequence.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" 
                            string="Apply" class="btn-primary" icon="fa-check"/>
                    <button name="action_cancel" type="object" 
                            string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
