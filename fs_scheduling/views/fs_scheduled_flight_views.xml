<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_fs_scheduled_flight_tree" model="ir.ui.view">
        <field name="name">fs.scheduled.flight.list</field>
        <field name="model">fs.scheduled.flight</field>
        <field name="arch" type="xml">
            <list decoration-info="is_sim"
                  decoration-danger="has_any_conflict"
                  sample="1">
                <field name="is_sim" column_invisible="1"/>
                <field name="has_any_conflict" column_invisible="1"/>
                <field name="date"/>
                <field name="has_instructor_conflict" string="⚠️" optional="show"/>
                <field name="callsign"/>
                <field name="start_time" widget="float_time" string="ETD"/>
                <field name="duration" widget="float_time"/>
                <field name="aircraft_id"/>
                <field name="pilot1_display" string="Pilot 1"/>
                <field name="pilot2_display" string="Pilot 2"/>
                <field name="flight_type_id" string="Type" optional="show"/>
                <field name="mission_id" optional="hide"/>
                <field name="route_id" string="Route" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View: Modern & Smart logic -->
    <record id="view_fs_scheduled_flight_form" model="ir.ui.view">
        <field name="name">fs.scheduled.flight.form</field>
        <field name="model">fs.scheduled.flight</field>
        <field name="arch" type="xml">
            <form class="o_fs_flight_form">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <widget name="web_ribbon" title="EXAM" bg_color="bg-warning" invisible="not is_exam"/>
                    
                    


                    <!-- Dynamic Hero Section -->
                    <div class="card border-0 rounded-3 shadow-sm mb-4" 
                         style="overflow: hidden; position: relative; background: #f8fafc;">
                        <div class="card-body p-0">
                            <div class="row g-0">
                                <!-- Left Indicator Bar: Color changes based on category -->
                                <div class="col-auto bg-primary" style="width: 8px;"
                                     invisible="flight_category != 'student_training'"/>
                                <div class="col-auto bg-secondary" style="width: 8px;"
                                     invisible="flight_category != 'staff_training'"/>

                                <div class="col p-4">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center">
                                            <span class="badge rounded-pill me-2 px-3 py-2" 
                                                  invisible="flight_category != 'student_training'" style="background: rgba(13, 110, 253, 0.1); color: #0d6efd;">
                                                <i class="fa fa-graduation-cap me-1" title="Student Training"/>
                                                STUDENT TRAINING
                                            </span>
                                            <span class="badge rounded-pill me-2 px-3 py-2" 
                                                  invisible="flight_category != 'staff_training'" style="background: rgba(108, 117, 125, 0.1); color: #6c757d;">
                                                <i class="fa fa-users me-1" title="Staff Training"/>
                                                PILOT/STAFF TRAINING
                                            </span>
                                            <!-- Flight Type Badge -->
                                            <field name="flight_type_id" widget="badge" class="ms-2"/>
                                        </div>
                                        <div class="text-muted small">
                                            <i class="fa fa-clock-o me-1" title="Last Update"/> Last Updated: <field name="write_date" widget="remaining_days" class="fw-bold"/>
                                        </div>
                                    </div>
                                    
                                    <div class="row align-items-end">
                                        <div class="col">
                                            <label for="callsign" class="text-uppercase small fw-bold text-muted mb-0">Callsign</label>
                                            <h1 class="mb-0 mt-n1 text-primary fw-bolder">
                                                <field name="callsign" placeholder="e.g. ABS0001" class="oe_inline"/>
                                            </h1>
                                        </div>
                                        <div class="col-auto text-end">
                                            <div class="d-flex gap-4">
                                                <div class="text-center">
                                                    <div class="text-uppercase small fw-bold text-muted">Date</div>
                                                    <div class="h4 mb-0 fw-bold"><field name="date"/></div>
                                                </div>
                                                <div class="text-center border-start ps-4">
                                                    <div class="text-uppercase small fw-bold text-muted">Block Time</div>
                                                    <div class="h4 mb-0 fw-bold text-primary">
                                                        <field name="start_time" widget="float_time"/>
                                                        <i class="fa fa-long-arrow-right mx-2 text-muted small" title="to"/>
                                                        <field name="end_time" widget="float_time"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div role="status" invisible="not is_exam" 
                         style="background: rgba(255,193,7,0.1); display: flex; align-items: center; margin-bottom: 1.5rem; border-radius: 0.5rem; padding: 1rem;">
                        <i class="fa fa-exclamation-triangle fa-2x me-3 text-warning" title="Warning"/>
                        <div>
                            <h6 class="fw-bold mb-1">EXAM MISSION DETECTED</h6>
                            <p class="mb-0 small">This mission requires an instructor with valid <strong>Examinator Qualifications</strong>. Verification will be performed on dispatch.</p>
                        </div>
                    </div>

                    <!-- Conflict Warning Banners -->
                    <field name="has_any_conflict" invisible="1"/>
                    <field name="has_instructor_conflict" invisible="1"/>
                    <field name="has_aircraft_conflict" invisible="1"/>
                    
                    <div role="alert" invisible="not has_any_conflict" 
                         style="background: rgba(220,53,69,0.1); display: flex; align-items: flex-start; margin-bottom: 1.5rem; border-radius: 0.5rem; padding: 1rem; border: 1px solid rgba(220,53,69,0.3);">
                        <i class="fa fa-exclamation-circle fa-2x me-3 text-danger" title="Conflict Warning"/>
                        <div>
                            <h6 class="fw-bold mb-1 text-danger">⚠️ SCHEDULING CONFLICT DETECTED</h6>
                            <p class="mb-1 small" invisible="not has_instructor_conflict">
                                <i class="fa fa-user-times me-1" title="Instructor Conflict"/>
                                <strong>Crew Member Conflict:</strong> <field name="instructor_conflict_details" class="d-inline"/>
                            </p>
                            <p class="mb-0 small" invisible="not has_aircraft_conflict">
                                <i class="fa fa-plane me-1" title="Aircraft Conflict"/>
                                <strong>Aircraft Conflict:</strong> <field name="aircraft_conflict_details" class="d-inline"/>
                            </p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Column 1: Configuration -->
                        <div class="col-lg-4">
                            <div class="card border-0 bg-light rounded-3 h-100 shadow-sm-hover">
                                <div class="card-body">
                                    <h5 class="fw-bold mb-3 border-bottom pb-2">
                                        <i class="fa fa-sliders text-primary me-2" title="Configuration"/>1️⃣ Mission Type
                                    </h5>
                                    <div class="text-muted small mb-3">
                                        <i class="fa fa-info-circle me-1" title="Info"/>Select category first, then fill in crew details.
                                    </div>
                                    <group>
                                        <field name="flight_category" widget="radio" options="{'horizontal': false}"/>
                                    </group>
                                    
                                    <field name="is_sim" invisible="1"/>
                                    <field name="is_extra" invisible="1"/>
                                    <field name="is_exam" invisible="1"/>
                                </div>
                            </div>
                        </div>

                        <!-- Column 2: Crew Selection (Pilot 1 / Pilot 2) -->
                        <div class="col-lg-8">
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-body">
                                    <h5 class="fw-bold mb-4 border-bottom pb-2">
                                        <i class="fa fa-users text-primary me-2" title="Crew"/>2️⃣ Flight Crew
                                    </h5>
                                    
                                    <div class="row">
                                        <!-- Pilot 1 -->
                                        <div class="col-md-6 border-end">
                                            <span class="o_form_label fw-bold text-muted small mb-2 d-block">
                                                <i class="fa fa-user me-1" title="Pilot 1"/>PILOT 1
                                            </span>
                                            
                                            <!-- Unified Crew Member Selector -->
                                            <div class="p-3 bg-light rounded-3 mb-3 border">
                                                <field name="pilot1_crew_id" options="{'no_create': True}" 
                                                       placeholder="Select Crew Member..."
                                                       domain="flight_category == 'staff_training' and [('member_type', 'in', ['instructor', 'pilot']), ('has_expired_qualification', '=', False)] or [('has_expired_qualification', '=', False)]"/>
                                            </div>
                                            
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <span class="small text-muted">Function:</span>
                                                <field name="pilot1_function" class="oe_inline"/>
                                            </div>
                                        </div>

                                        <!-- Pilot 2 -->
                                        <div class="col-md-6">
                                            <span class="o_form_label fw-bold text-muted small mb-2 d-block">
                                                <i class="fa fa-user-plus me-1" title="Pilot 2"/>PILOT 2
                                            </span>
                                            
                                            <!-- Unified Crew Member Selector -->
                                            <div class="p-3 bg-light rounded-3 mb-3 border">
                                                <field name="pilot2_crew_id" options="{'no_create': True}" 
                                                       placeholder="Select Crew Member..."
                                                       domain="flight_category == 'staff_training' and [('member_type', 'in', ['instructor', 'pilot']), ('has_expired_qualification', '=', False)] or [('has_expired_qualification', '=', False)]"/>
                                            </div>
                                            
                                            <div class="d-flex align-items-center gap-2 mt-2">
                                                <span class="small text-muted">Function:</span>
                                                <field name="pilot2_function" class="oe_inline"/>
                                            </div>
                                            
                                            <div class="text-muted small d-flex align-items-center mt-2"
                                                 invisible="pilot2_function != 'supervisor'">
                                                <i class="fa fa-info-circle me-1" title="Info"/> Supervisor monitors from ground. No flight hours logged.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 mt-2">
                        <!-- Timing & Execution -->
                        <div class="col-lg-4">
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-body">
                                    <h5 class="fw-bold mb-4 border-bottom pb-2">
                                        <i class="fa fa-clock-o text-primary me-2" title="Timing"/>Timeline
                                    </h5>
                                    <group>
                                        <field name="duration" widget="float_time" string="Estimated Duration"/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <!-- Logistics -->
                        <div class="col-lg-8">
                            <div class="card border-0 shadow-sm rounded-3 h-100">
                                <div class="card-body">
                                    <h5 class="fw-bold mb-4 border-bottom pb-2">
                                        <i class="fa fa-map-marker text-primary me-2" title="Logistics"/>Mission Details
                                    </h5>
                                    <group>
                                        <group>
                                            <field name="aircraft_domain" invisible="1"/>
                                            <field name="aircraft_id" options="{'no_create': True, 'no_open': False}"
                                                   domain="aircraft_domain"/>
                                            <field name="route_id" options="{'no_create': True}"/>
                                        </group>
                                        <group>
                                            <!-- Student Training: show syllabus mission -->
                                            <field name="mission_domain" invisible="1"/>
                                            <field name="mission_id" 
                                                   invisible="flight_category != 'student_training'" 
                                                   options="{'no_create': True}"
                                                   domain="mission_domain"/>
                                            <!-- Staff Training: show activity OR custom activity -->
                                            <field name="activity_id" 
                                                   invisible="flight_category == 'student_training' or custom_activity_id" 
                                                   options="{'no_create': True}"/>
                                            <field name="custom_activity_id" 
                                                   invisible="flight_category == 'student_training' or activity_id" 
                                                   options="{'no_create': True}"/>
                                            <field name="discipline_id" readonly="1"/>
                                        </group>
                                    </group>
                                </div>
                            </div>
                        </div>
                    </div>

                    <notebook class="mt-4">
                        <page name="notes" string="Instructions &amp; Notes">
                            <field name="notes" placeholder="Specify mission objectives, weather minimums, or special instructions..." 
                                   class="border-0 shadow-none"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Timeline View -->

    <!-- Search View -->
    <record id="view_fs_scheduled_flight_search" model="ir.ui.view">
        <field name="name">fs.scheduled.flight.search</field>
        <field name="model">fs.scheduled.flight</field>
        <field name="arch" type="xml">
            <search string="Scheduled Flight Search">
                <field name="callsign"/>
                <field name="pilot1_display"/>
                <field name="pilot2_display"/>
                <field name="aircraft_id"/>
                <field name="date"/>
                <field name="route_id"/>
                <separator/>
                <filter name="filter_student" string="📚 Student Training" domain="[('flight_category', '=', 'student_training')]"/>
                <filter name="filter_staff" string="👥 Pilot/Staff Training" domain="[('flight_category', '=', 'staff_training')]"/>
                <separator/>
                <filter name="filter_exam" string="🏆 Exams" domain="[('is_exam', '=', True)]"/>
                <filter name="filter_solo" string="🧑 Solo Flights" domain="[('pilot1_function', '=', 'solo')]"/>
                <separator/>
                <filter name="filter_sim_only" string="🖥️ Simulators Only" domain="[('is_sim', '=', True)]"/>
                <filter name="filter_hide_sim" string="✈️ Hide Simulators" domain="[('is_sim', '=', False)]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('date', '=', context_today())]"/>
                <filter name="tomorrow" string="Tomorrow" domain="[('date', '=', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_conflicts" string="⚠️ With Conflicts" domain="[('has_any_conflict', '=', True)]"/>
                <separator/>
                <filter name="group_by_aircraft" string="Aircraft" context="{'group_by': 'aircraft_id'}"/>
                <filter name="group_by_instructor" string="Instructor" context="{'group_by': 'pilot2_crew_id'}"/>
                <filter name="group_by_category" string="Mission Category" context="{'group_by': 'flight_category'}"/>
                <filter name="group_by_route" string="Route" context="{'group_by': 'route_id'}"/>
                <filter name="group_by_type" string="Flight Type" context="{'group_by': 'flight_type_id'}"/>
                <separator/>
                <filter name="group_by_year" string="Year" context="{'group_by': 'date_year'}"/>
                <filter name="group_by_month" string="Month" context="{'group_by': 'date_month'}"/>
                <filter name="group_by_day" string="Day" context="{'group_by': 'date_day'}"/>
                <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_fs_scheduled_flight_tomorrow" model="ir.actions.act_window">
        <field name="name">Tomorrow's Flights</field>
        <field name="res_model">fs.scheduled.flight</field>
        <field name="view_mode">timeline,list,form</field>
        <field name="search_view_id" ref="view_fs_scheduled_flight_search"/>
        <field name="context">{'search_default_tomorrow': 1, 'search_default_filter_hide_sim': 1, 'tz': 'UTC'}</field>
    </record>

    <!-- Tree View for All Flights (with date grouping) -->
    <record id="view_fs_scheduled_flight_tree_grouped" model="ir.ui.view">
        <field name="name">fs.scheduled.flight.list.grouped</field>
        <field name="model">fs.scheduled.flight</field>
        <field name="arch" type="xml">
            <list decoration-info="is_sim"
                  decoration-danger="has_any_conflict"
                  default_group_by="date_year,date_month,date_day"
                  sample="1">
                <field name="is_sim" column_invisible="1"/>
                <field name="has_any_conflict" column_invisible="1"/>
                <field name="date"/>
                <field name="has_instructor_conflict" string="⚠️" optional="show"/>
                <field name="callsign"/>
                <field name="start_time" widget="float_time" string="ETD"/>
                <field name="duration" widget="float_time"/>
                <field name="aircraft_id"/>
                <field name="pilot1_display" string="Pilot 1"/>
                <field name="pilot2_display" string="Pilot 2"/>
                <field name="flight_type_id" string="Type" optional="show"/>
                <field name="mission_id" optional="hide"/>
                <field name="route_id" string="Route" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_fs_scheduled_flight_all" model="ir.actions.act_window">
        <field name="name">All Flights</field>
        <field name="res_model">fs.scheduled.flight</field>
        <field name="view_mode">timeline,list,form</field>
        <field name="search_view_id" ref="view_fs_scheduled_flight_search"/>
        <field name="context">{'search_default_filter_hide_sim': 1, 'tz': 'UTC'}</field>
    </record>

    <!-- Link specific views to All Flights action -->
<!--     <record id="action_fs_scheduled_flight_all_view_timeline" model="ir.actions.act_window.view"> -->
<!--         <field name="sequence" eval="1"/> -->
<!--         <field name="view_mode">timeline</field> -->
<!--         <field name="view_id" ref="view_fs_scheduled_flight_timeline"/> -->
<!--         <field name="act_window_id" ref="action_fs_scheduled_flight_all"/> -->
<!--     </record> -->
    <record id="action_fs_scheduled_flight_all_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_fs_scheduled_flight_tree_grouped"/>
        <field name="act_window_id" ref="action_fs_scheduled_flight_all"/>
    </record>
    <record id="action_fs_scheduled_flight_all_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fs_scheduled_flight_form"/>
        <field name="act_window_id" ref="action_fs_scheduled_flight_all"/>
    </record>
</odoo>
