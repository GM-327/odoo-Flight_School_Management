<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default Cancellation Reasons -->
    <record id="cancellation_reason_weather" model="fs.cancellation.reason">
        <field name="code">WX</field>
        <field name="name">Weather</field>
    </record>
    <record id="cancellation_reason_aircraft" model="fs.cancellation.reason">
        <field name="code">MEC</field>
        <field name="name">Technical Issue</field>
    </record>
    <record id="cancellation_reason_personnel" model="fs.cancellation.reason">
        <field name="code">PERS</field>
        <field name="name">Personnel</field>
    </record>
    <record id="cancellation_reason_ops" model="fs.cancellation.reason">
        <field name="code">OPS</field>
        <field name="name">OPS</field>
    </record>

    <!-- Default Config Parameters -->
    <function model="ir.config_parameter" name="set_param">
        <value>flight_school.mission_callsign_prefix</value>
        <value>ABS</value>
    </function>
    <function model="ir.config_parameter" name="set_param">
        <value>flight_school.scheduling_buffer_minutes</value>
        <value>15</value>
    </function>
    <function model="ir.config_parameter" name="set_param">
        <value>flight_school.scheduling_time_slot_minutes</value>
        <value>15</value>
    </function>
</odoo>
