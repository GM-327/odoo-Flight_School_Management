<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Settings -->
        <record id="config_parameter_home_base" model="ir.config_parameter">
            <field name="key">flight_school.default_home_base</field>
            <field name="value">DTTI</field>
        </record>

        <record id="config_parameter_tz" model="ir.config_parameter">
            <field name="key">flight_school.default_timezone</field>
            <field name="value">UTC</field>
        </record>

        <record id="config_parameter_min_rest" model="ir.config_parameter">
            <field name="key">flight_school.minimum_rest_hours</field>
            <field name="value">12.0</field>
        </record>

        <record id="config_parameter_max_flight" model="ir.config_parameter">
            <field name="key">flight_school.max_daily_flight_hours</field>
            <field name="value">8.0</field>
        </record>
    </data>
</odoo>
