<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
    Flight School Settings View
    ===========================
    Base configuration interface for flight school parameters.
    Other modules extend this view with their own settings blocks.
    -->

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fs_core</field>
        <field name="model">res.config.settings</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Flight School" string="Flight School" name="fs_core" groups="fs_core.group_flight_school_admin">
                    
                    <!-- General Settings -->
                    <block title="Organization Defaults" name="fs_general_settings">
                        <setting string="Default Home Base" help="ICAO airport code for new aircraft">
                            <field name="fs_default_home_base"/>
                        </setting>
                        <setting string="Default Country" help="Default nationality for new personnel">
                            <field name="fs_default_country_id"/>
                        </setting>
                    </block>

                    <!-- 
                    Other modules add their settings blocks here via xpath inheritance:
                    - fs_people: Instructor limits, Personnel expiry warnings
                    - fs_fleet: Aircraft maintenance warnings
                    - fs_training: Training class warnings
                    - fs_scheduling: Scheduling configuration
                    -->
                    
                </app>
            </xpath>
        </field>
    </record>

</odoo>
