<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fleet" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fleet</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="21"/>
        <field name="inherit_id" ref="fs_core.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='fs_core']" position="inside">
                <!-- Aircraft Maintenance -->
                <block title="Aircraft Maintenance" name="fs_aircraft_maintenance" groups="fs_core.group_flight_school_manager">
                    <setting string="Maintenance Date Warning" help="Days before aircraft maintenance to show warning">
                        <div class="text-muted">
                            Show warning <field name="fs_maintenance_warning_days" class="o_field_integer oe_inline"/> days before expiry
                        </div>
                    </setting>
                    <setting string="Maintenance Warning" help="Hours before maintenance is due to show warning">
                        <div class="text-muted">
                            Show warning <field name="fs_maintenance_warning_hours" class="o_field_float oe_inline" widget="float_time"/> hours before due
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
