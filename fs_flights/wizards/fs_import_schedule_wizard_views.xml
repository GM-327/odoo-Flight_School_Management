<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_import_schedule_wizard_form" model="ir.ui.view">
        <field name="name">fs.import.schedule.wizard.form</field>
        <field name="model">fs.import.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Schedule">
                <group>
                    <field name="date"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="scheduled_count == 0">
                    <div class="d-flex justify-content-between">
                        <span>Scheduled Flights:</span>
                        <field name="scheduled_count" class="fw-bold"/>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Already Published:</span>
                        <field name="already_published_count" class="fw-bold"/>
                    </div>
                    <hr/>
                    <div class="d-flex justify-content-between text-primary">
                        <span><strong>To Publish:</strong></span>
                        <field name="to_publish_count" class="fw-bold"/>
                    </div>
                </div>
                <div class="alert alert-warning" role="alert" invisible="scheduled_count &gt; 0">
                    No scheduled flights found for this date.
                </div>
                <footer>
                    <button name="action_import" string="Import / Publish" type="object" class="btn-primary"
                            invisible="to_publish_count == 0"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Menu Item (In Scheduling root) -->
    <record id="action_fs_import_schedule_wizard" model="ir.actions.act_window">
        <field name="name">Import Schedule</field>
        <field name="res_model">fs.import.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_fs_import_schedule_wizard"
              name="Publish Schedule"
              parent="fs_scheduling.menu_fs_scheduling_root"
              action="action_fs_import_schedule_wizard"
              sequence="95"/>
</odoo>
