<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cancel Flight Wizard Form -->
    <record id="view_fs_flight_cancel_wizard_form" model="ir.ui.view">
        <field name="name">fs.flight.cancel.wizard.form</field>
        <field name="model">fs.flight.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Flight" dialog_size="small" size="sm" class="fs_small_wizard">
                <group>
                    <field name="flight_log_id" invisible="1"/>
                    <field name="callsign" readonly="1"/>
                    <field name="cancellation_reason_id" options="{'no_create': True}"/>
                    <field name="notes" placeholder="Additional notes about cancellation..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm Cancellation" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
