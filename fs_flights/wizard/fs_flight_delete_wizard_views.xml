<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fs_flight_delete_wizard_view_form" model="ir.ui.view">
        <field name="name">fs.flight.delete.wizard.form</field>
        <field name="model">fs.flight.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Deletion" dialog_size="small" size="sm" class="fs_small_wizard">
                <group>
                    <div class="d-flex align-items-center rounded" role="alertdialog" aria-modal="true" aria-labelledby="alert_heading" 
                         style="margin-bottom: 0; background-color: #f8d7da; color: #842029; padding: 1rem; border: 1px solid #f5c6cb;">
                        <i class="fa fa-exclamation-triangle fa-3x me-3" title="Warning"/>
                        <div>
                            <h4 id="alert_heading" class="fw-bold">Warning!</h4>
                            <p class="mb-0 fs-5">
                                Are you sure you want to 
                                <span class="fw-bolder text-uppercase" style="text-decoration: underline;">permanently delete</span> 
                                this scheduled flight?
                            </p>
                            <hr/>
                            <p class="mb-0">
                                This action <span class="fw-bold">cannot</span> be undone.
                            </p>
                        </div>
                    </div>
                </group>
                <footer>
                    <button name="action_delete" string="Delete Flight" type="object" class="btn-danger btn-lg" icon="fa-trash"/>
                    <button string="Cancel" class="btn-secondary btn-lg" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
