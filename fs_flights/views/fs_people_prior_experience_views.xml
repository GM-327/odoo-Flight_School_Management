<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_student_form_prior_experience" model="ir.ui.view">
        <field name="name">fs.student.form.prior.experience</field>
        <field name="model">fs.student</field>
        <field name="inherit_id" ref="fs_people.view_fs_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_prior_experience" type="object" class="oe_stat_button" icon="fa-history">
                    <field name="prior_experience_count" widget="statinfo" string="Prior Experience"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_fs_pilot_form_prior_experience" model="ir.ui.view">
        <field name="name">fs.pilot.form.prior.experience</field>
        <field name="model">fs.pilot</field>
        <field name="inherit_id" ref="fs_people.view_fs_pilot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_prior_experience" type="object" class="oe_stat_button" icon="fa-history">
                    <field name="prior_experience_count" widget="statinfo" string="Prior Experience"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_fs_instructor_form_prior_experience" model="ir.ui.view">
        <field name="name">fs.instructor.form.prior.experience</field>
        <field name="model">fs.instructor</field>
        <field name="inherit_id" ref="fs_people.view_fs_instructor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_prior_experience" type="object" class="oe_stat_button" icon="fa-history">
                    <field name="prior_experience_count" widget="statinfo" string="Prior Experience"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
