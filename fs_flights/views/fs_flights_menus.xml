<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main Menu: Flights -->
    <menuitem id="menu_fs_flights_root"
              name="Flights"
              web_icon="fs_flights,static/description/icon.svg"
              sequence="55"/>

    <!-- Operations Board Menu -->
    <menuitem id="menu_fs_operations_board"
              name="Operations Board"
              parent="menu_fs_flights_root"
              action="action_open_operations_board"
              sequence="10"/>

    <!-- Flight Logs Menu -->
    <menuitem id="menu_fs_flight_logs"
              name="Flight Logs"
              parent="menu_fs_flights_root"
              action="action_fs_flight"
              sequence="15"/>

    <!-- Simulator Board Menu -->
    <menuitem id="menu_fs_simulator_board"
              name="Simulator Board"
              parent="menu_fs_flights_root"
              action="action_open_simulator_board"
