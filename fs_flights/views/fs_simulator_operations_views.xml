<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Simulator Operations Form (Full-Screen Dashboard) -->
    <record id="view_fs_simulator_operations_form" model="ir.ui.view">
        <field name="name">fs.simulator.operations.form</field>
        <field name="model">fs.simulator.operations</field>
        <field name="arch" type="xml">
            <form string="Simulator Operations" class="fs_operations_board" create="0">
                <field name="date" invisible="1"/>
                
                <!-- Fixed Header Section -->
                <div class="fs_fixed_header">
                    <!-- Header: Logo | Date | Clock -->
                    <div class="row bg-info text-white p-2 mb-2">
                        <div class="col-3 d-flex align-items-center">
                            <img src="/web/binary/company_logo" style="max-height: 50px; background: transparent;" alt="Logo"/>
                        </div>
                        <div class="col-6 text-center d-flex align-items-center justify-content-center">
                            <button name="action_previous_day" type="object" class="btn btn-link text-white p-0 me-3" title="Previous Day">
                                <i class="fa fa-chevron-left fa-2x"/>
                            </button>
                            <h1 class="mb-0 fs-1 fw-bold" style="letter-spacing: 2px;">
                                <field name="date_display" readonly="1" class="text-white"/>
                            </h1>
                            <button name="action_next_day" type="object" class="btn btn-link text-white p-0 ms-3" title="Next Day">
                                <i class="fa fa-chevron-right fa-2x"/>
                            </button>
                        </div>
                        <div class="col-3 text-end d-flex align-items-center justify-content-end">
                            <span class="fs-1 fw-bold" id="live_clock">--:--</span>
                        </div>
                    </div>

                    <!-- Summary Cards Row -->
                    <div class="row g-2 mb-2 px-3">
                        <div class="col">
                            <div class="card text-center h-100 border-warning bg-warning text-white">
                                <div class="card-body p-2 d-flex align-items-center justify-content-center">
                                    <span class="me-2 text-white">📋 Scheduled:</span>
                                    <span class="fs-4 fw-bold text-white">
                                        <field name="sessions_scheduled"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 border-primary bg-primary text-white">
                                <div class="card-body p-2 d-flex align-items-center justify-content-center">
                                    <span class="me-2 text-white">🖥️ In Progress:</span>
                                    <span class="fs-4 fw-bold text-white">
                                        <field name="sessions_in_progress"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 border-success bg-success text-white">
                                <div class="card-body p-2 d-flex align-items-center justify-content-center">
                                    <span class="me-2 text-white">✅ Done:</span>
                                    <span class="fs-4 fw-bold text-white">
                                        <field name="sessions_completed"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 border-danger bg-danger text-white">
                                <div class="card-body p-2 d-flex align-items-center justify-content-center">
                                    <span class="me-2 text-white">❌ Cancelled:</span>
                                    <span class="fs-4 fw-bold text-white">
                                        <field name="sessions_cancelled"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 border-info bg-info text-white">
                                <div class="card-body p-2 d-flex align-items-center justify-content-center">
                                    <span class="me-2 text-white">⏱️ Hours:</span>
                                    <span class="fs-4 fw-bold text-white">
                                        <field name="total_hours_display"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 border-secondary bg-secondary text-dark">
                                <div class="card-body p-2 d-flex align-items-center justify-content-center">
                                    <span class="me-2 text-dark">🆕 Last SIM:</span>
                                    <span class="fs-4 fw-bold text-dark">
                                        <field name="last_sim_callsign"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mb-2 px-3">
                        <div class="col text-center">
                            <button name="action_add_session" type="object" class="btn btn-info btn-lg me-2">
                                <i class="fa fa-plus"/> Add Session
                            </button>
                            <field name="refresh_dummy" widget="soft_refresh" nolabel="1" class="d-inline-block me-2"/>
                            <field name="fullscreen_dummy" widget="fullscreen_toggle" nolabel="1" class="d-inline-block me-2"/>
                            <field name="carousel_control_dummy" widget="carousel_control" nolabel="1" class="d-inline-block"/>
                        </div>
                    </div>
                </div>

                <!-- Hidden Pagination Fields -->
                <field name="current_page" invisible="1"/>
                <field name="page_size" invisible="1"/>
                <field name="total_pages" invisible="1"/>
                <field name="session_ids" invisible="1"/>

                <!-- Session List Section with Carousel Navigation -->
                <div class="fs_flight_list_section">
                    <!-- Navigation Header -->
                    <div class="row px-3 p-1 bg-white border-bottom align-items-center fs_pagination_bar">
                        <div class="col-4">
                            <button name="action_first_page" type="object" 
                                    class="btn btn-outline-secondary btn-sm me-1" 
                                    invisible="total_pages &lt;= 1">
                                <i class="fa fa-angle-double-left" title="First Page"/>
                            </button>
                            <button name="action_prev_page" type="object" 
                                    class="btn btn-secondary btn-sm" 
                                    invisible="total_pages &lt;= 1">
                                <i class="fa fa-chevron-left" title="Previous"/> Previous
                            </button>
                        </div>
                        <div class="col-4 text-center">
                            <span class="fs-5 fw-bold text-muted">
                                <field name="page_info" class="d-inline"/>
                            </span>
                            <span class="ms-2 text-muted">
                                (<field name="session_count" class="d-inline"/> sessions)
                            </span>
                        </div>
                        <div class="col-4 text-end">
                            <button name="action_next_page" type="object" 
                                    class="btn btn-secondary btn-sm" 
                                    invisible="total_pages &lt;= 1">
                                Next <i class="fa fa-chevron-right" title="Next"/>
                            </button>
                            <button name="action_last_page" type="object" 
                                    class="btn btn-outline-secondary btn-sm ms-1" 
                                    invisible="total_pages &lt;= 1">
                                <i class="fa fa-angle-double-right" title="Last Page"/>
                            </button>
                        </div>
                    </div>

                    <!-- Paginated Session List -->
                    <div class="fs_flight_list px-3">
                        <field name="paginated_session_ids" mode="list" readonly="0" 
                               options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True, 'no_delete': True}">
                            <list string="Today's Simulator Sessions" editable="bottom" create="0" delete="0" open="0"
                                  decoration-info="status == 'in_progress'" 
                                  decoration-success="status == 'done'"
                                  decoration-danger="status == 'cancelled'"
                                  decoration-bf="1"
                                  default_order="callsign asc">
                                <field name="callsign" string="Callsign" readonly="1"/>
                                <field name="aircraft_registration" string="Simulator" readonly="1"/>
                                <field name="pilot1_callsign" string="P1" readonly="1"/>
                                <field name="pilot2_callsign" string="P2" readonly="1"/>
                                <field name="activity_display" string="Activity" readonly="1"/>
                                <field name="etd" widget="float_time" string="ETD" readonly="1"/>
                                <field name="atd" widget="float_time" string="ATD"/>
                                <field name="eta" widget="float_time" string="ETA" readonly="1"/>
                                <field name="ata" widget="float_time" string="ATA"/>
                                <field name="actual_duration" widget="float_time" string="Duration" readonly="1"/>
                                <field name="status" column_invisible="1"/>
                                <field name="status_display" string="Status" widget="badge" 
                                       decoration-warning="status == 'scheduled'"
                                       decoration-info="status == 'in_progress'"
                                       decoration-success="status == 'done'"
                                       decoration-danger="status == 'cancelled'"/>
                                <field name="cancellation_code" string="Cancel" readonly="1" column_invisible="1"/>
                                <button name="action_open_form" type="object" icon="fa-pencil" class="btn-link" title="Edit"/>
                                <button name="action_cancel_flight" type="object" icon="fa-times" 
                                        class="btn-link text-danger" invisible="status in ('done', 'cancelled')" title="Cancel"/>
                                <button name="action_delete_flight" type="object" icon="fa-trash" 
                                        class="btn-link text-dark" title="Delete"/>
                            </list>
                        </field>
                    </div>
                </div>

                <!-- Footer: Available Simulators -->
                <div class="row bg-light p-2 border-top fs_operations_footer">
                    <div class="col-12 d-flex align-items-center justify-content-center">
                        <span class="text-muted fw-bold me-2">🖥️ Available Simulators:</span>
                        <field name="available_simulators_html" class="d-inline"/>
                    </div>
                </div>

            </form>
        </field>
    </record>

    <!-- Simulator Operations Action -->
    <record id="action_fs_simulator_operations" model="ir.actions.act_window">
        <field name="name">Simulator Board</field>
        <field name="res_model">fs.simulator.operations</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
        <field name="context">{}</field>
    </record>

    <!-- Server Action to Create and Open Simulator Dashboard -->
    <record id="action_open_simulator_board" model="ir.actions.server">
        <field name="name">Open Simulator Board</field>
        <field name="model_id" ref="model_fs_simulator_operations"/>
        <field name="state">code</field>
        <field name="code">
today = datetime.date.today()

record = model.search([('date', '=', today)], limit=1)
if not record:
    record = model.create({'date': today})

action = {
    'name': 'Simulator Operations Board',
    'type': 'ir.actions.act_window',
    'res_model': 'fs.simulator.operations',
    'res_id': record.id,
    'view_mode': 'form',
    'view_id': env.ref('fs_flights.view_fs_simulator_operations_form').id,
    'target': 'main',
    'flags': {'mode': 'edit'},
}
        </field>
    </record>

</odoo>
