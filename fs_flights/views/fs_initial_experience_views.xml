<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Initial Experience List View -->
    <record id="view_fs_initial_experience_list" model="ir.ui.view">
        <field name="name">fs.initial.experience.list</field>
        <field name="model">fs.initial.experience</field>
        <field name="arch" type="xml">
            <list decoration-success="is_applied" decoration-muted="not is_applied">
                <field name="person_type"/>
                <field name="instructor_id" invisible="person_type != 'instructor'"/>
                <field name="pilot_id" invisible="person_type != 'pilot'"/>
                <field name="student_id" invisible="person_type != 'student'"/>
                <field name="entry_date"/>
                <field name="initial_flight_hours" widget="float_time"/>
                <field name="initial_sim_hours" widget="float_time"/>
                <field name="initial_solo_hours" widget="float_time"/>
                <field name="initial_instruction_hours" widget="float_time" invisible="person_type != 'instructor'"/>
                <field name="description"/>
                <field name="is_applied" widget="boolean_toggle" readonly="1"/>
                <button name="action_apply_hours" type="object" string="Apply" 
                        class="btn-success" icon="fa-check" invisible="is_applied"/>
                <button name="action_revert_hours" type="object" string="Revert" 
                        class="btn-warning" icon="fa-undo" invisible="not is_applied"
                        confirm="Are you sure you want to revert these hours?"/>
            </list>
        </field>
    </record>

    <!-- Initial Experience Form View -->
    <record id="view_fs_initial_experience_form" model="ir.ui.view">
        <field name="name">fs.initial.experience.form</field>
        <field name="model">fs.initial.experience</field>
        <field name="arch" type="xml">
            <form string="Initial Experience">
                <header>
                    <button name="action_apply_hours" type="object" string="Apply Hours" 
                            class="btn-primary" invisible="is_applied"/>
                    <button name="action_revert_hours" type="object" string="Revert Hours" 
                            class="btn-warning" invisible="not is_applied"
                            confirm="Are you sure you want to revert these hours from the person's totals?"/>
                    <field name="is_applied" widget="badge" 
                           decoration-success="is_applied" decoration-muted="not is_applied"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="is_applied">
                        <span class="fa fa-info-circle me-2" title="Info"/> 
                        Enter the initial hours and click <strong>Apply Hours</strong> to add them to the person's totals.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="not is_applied">
                        <span class="fa fa-check-circle me-2" title="Success"/> 
                        These hours have been applied to the person's totals.
                    </div>
                    <group>
                        <group string="Person">
                            <field name="person_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="instructor_id" invisible="person_type != 'instructor'" 
                                   required="person_type == 'instructor'"/>
                            <field name="pilot_id" invisible="person_type != 'pilot'"
                                   required="person_type == 'pilot'"/>
                            <field name="student_id" invisible="person_type != 'student'"
                                   required="person_type == 'student'"/>
                        </group>
                        <group string="Entry Details">
                            <field name="entry_date"/>
                            <field name="description" placeholder="e.g., Previous employer, Other flight school"/>
                        </group>
                    </group>
                    <group>
                        <group string="Flight Hours">
                            <field name="initial_flight_hours" widget="float_time"/>
                            <field name="initial_sim_hours" widget="float_time"/>
                            <field name="initial_solo_hours" widget="float_time"/>
                        </group>
                        <group string="Instruction Hours" invisible="person_type != 'instructor'">
                            <field name="initial_instruction_hours" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Application Status" invisible="not is_applied">
                        <field name="applied_date" readonly="1"/>
                        <field name="applied_by" readonly="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Additional notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Initial Experience Search View -->
    <record id="view_fs_initial_experience_search" model="ir.ui.view">
        <field name="name">fs.initial.experience.search</field>
        <field name="model">fs.initial.experience</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_applied" string="Applied" domain="[('is_applied', '=', True)]"/>
                <filter name="filter_pending" string="Pending" domain="[('is_applied', '=', False)]"/>
                <separator/>
                <filter name="filter_instructors" string="Instructors" domain="[('person_type', '=', 'instructor')]"/>
                <filter name="filter_pilots" string="Pilots" domain="[('person_type', '=', 'pilot')]"/>
                <filter name="filter_students" string="Students" domain="[('person_type', '=', 'student')]"/>
                <separator/>
                <filter name="group_person_type" string="Person Type" context="{'group_by': 'person_type'}"/>
                <filter name="group_applied" string="Applied Status" context="{'group_by': 'is_applied'}"/>
            </search>
        </field>
    </record>

    <!-- Initial Experience Action -->
    <record id="action_fs_initial_experience" model="ir.actions.act_window">
        <field name="name">Initial Experience</field>
        <field name="res_model">fs.initial.experience</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record initial flight experience
            </p>
            <p>
                Enter hours accumulated before the system was implemented, 
                or from other flight schools/organizations.
            </p>
        </field>
    </record>
</odoo>
